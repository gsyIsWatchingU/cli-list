[
  {
    "Id": "browse-powershell",
    "Name": "目录 PowerShell",
    "Description": "浏览并预览文件，然后在指定目录打开 PowerShell",
    "Tags": ["终端", "目录"],
    "Action": "BrowsePowerShell",
    "CloseAfterLaunch": false
  },
  {
    "Id": "open-powershell",
    "Name": "打开 PowerShell",
    "Description": "在当前目录启动新的 PowerShell 窗口",
    "Tags": ["终端", "本地"],
    "Executable": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
    "Arguments": "-NoExit",
    "WorkingDirectory": "{context}",
    "CloseAfterLaunch": true
  },
  {
    "Id": "open-explorer",
    "Name": "在资源管理器中打开",
    "Description": "使用资源管理器打开当前目录",
    "Tags": ["目录", "本地"],
    "Executable": "explorer.exe",
    "Arguments": "{context:q}",
    "WorkingDirectory": "{context}",
    "CloseAfterLaunch": true
  },
  {
    "Id": "open-browser",
    "Name": "打开浏览器",
    "Description": "选择并打开本机已安装的浏览器",
    "Tags": ["浏览器", "本地"],
    "Action": "OpenBrowser",
    "CloseAfterLaunch": false
  },
  {
    "Id": "open-vscode",
    "Name": "使用 VS Code 打开",
    "Description": "在当前目录启动 Visual Studio Code",
    "Tags": ["开发", "编辑器"],
    "Executable": "code.cmd",
    "Arguments": ".",
    "WorkingDirectory": "{context}",
    "CloseAfterLaunch": true
  },
  {
    "Id": "minimize-all-windows",
    "Name": "最小化所有窗口",
    "Description": "一键最小化所有窗口，直接显示桌面",
    "Tags": ["系统", "窗口"],
    "Executable": "%SystemRoot%\\System32\\wscript.exe",
    "Arguments": "//B {appdir:q}\\minimize-all.vbs",
    "WorkingDirectory": "{context}",
    "CloseAfterLaunch": true
  },
  {
    "Id": "check-update",
    "Name": "检查更新",
    "Description": "从 GitHub 下载最新版本并自动更新重启",
    "Tags": ["系统", "更新"],
    "Action": "CheckUpdate",
    "CloseAfterLaunch": false
  }
]
