[
  {
    "Id": "browse-powershell",
    "Name": "目录 PowerShell",
    "Description": "浏览并预览文件，然后在指定目录打开 PowerShell",
    "Tags": ["终端", "目录"],
    "Action": "BrowsePowerShell",
    "CloseAfterLaunch": false
  },
  {
    "Id": "open-powershell",
    "Name": "打开 PowerShell",
    "Description": "在当前目录启动新的 PowerShell 窗口",
    "Tags": ["终端", "本地"],
    "Executable": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
    "Arguments": "-NoExit",
    "WorkingDirectory": "{context}",
    "CloseAfterLaunch": true
  },
  {
    "Id": "remote-traecode",
    "Name": "打开远端 TraeCode",
    "Description": "使用 TraeCode 连接 mygpu 并打开 /workspace/projects",
    "Tags": ["开发", "远程", "GPU"],
    "Executable": "%SystemRoot%\\System32\\wscript.exe",
    "Arguments": "//B \"%USERPROFILE%\\.cli-list\\gpu-trae.vbs\"",
    "WorkingDirectory": "{context}",
    "CloseAfterLaunch": true
  },
  {
    "Id": "open-explorer",
    "Name": "在资源管理器中打开",
    "Description": "使用资源管理器打开当前目录",
    "Tags": ["目录", "本地"],
    "Executable": "explorer.exe",
    "Arguments": "\"{context}\"",
    "WorkingDirectory": "{context}",
    "CloseAfterLaunch": true
  },
  {
    "Id": "open-vscode",
    "Name": "使用 VS Code 打开",
    "Description": "在当前目录启动 Visual Studio Code",
    "Tags": ["开发", "编辑器"],
    "Executable": "code.cmd",
    "Arguments": ".",
    "WorkingDirectory": "{context}",
    "CloseAfterLaunch": true
  },
  {
    "Id": "start-skill-atlas",
    "Name": "启动 Skill Atlas",
    "Description": "以开发模式启动并自动刷新界面",
    "Tags": ["开发", "工具"],
    "Executable": "%SystemRoot%\\System32\\wscript.exe",
    "Arguments": "//B \"%USERPROFILE%\\.cli-list\\skill-atlas-dev.vbs\"",
    "WorkingDirectory": "E:\\prj-gsy\\skill-atlas",
    "CloseAfterLaunch": true
  },
  {
    "Id": "open-zotero",
    "Name": "打开 Zotero",
    "Description": "启动 Zotero 文献管理器",
    "Tags": ["研究", "工具"],
    "Executable": "%ProgramData%\\Microsoft\\Windows\\Start Menu\\Programs\\Zotero.lnk",
    "Arguments": "",
    "WorkingDirectory": "D:\\software\\Zotero",
    "CloseAfterLaunch": true
  }
]
